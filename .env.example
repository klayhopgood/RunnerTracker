# Supabase — Settings → API (Project URL + API keys)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# MapTiler — cloud.maptiler.com → API Keys (server proxy uses this; not exposed in browser)
MAPTILER_KEY=
NEXT_PUBLIC_MAPTILER_KEY=

# Elevation correction (server-side only)
MAPBOX_ACCESS_TOKEN=              # mapbox.com → Access tokens
OPEN_ELEVATION_URL=https://api.open-elevation.com/api/v1

# SendGrid — for app-triggered emails (auth uses Supabase SMTP)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
VIEWER_TOKEN_SECRET=generate-a-long-random-string
